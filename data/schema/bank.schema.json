{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Soma Pamoja authoring passage",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "content_type", "level", "title", "text", "lang_tag", "variety", "orthography_ref", "source_id", "source_type", "author_type", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "content_type": {"const": "passage"},
    "level": {"enum": ["A", "B", "C"]},
    "title": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "lang_tag": {"type": "string", "minLength": 2},
    "variety": {"type": "string", "minLength": 1},
    "orthography_ref": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["original", "adapted_open", "licensed"]},
    "author_type": {"enum": ["human", "ai_assisted"]},
    "license_verified": {"type": "boolean"},
    "validator_code": {"type": ["string", "null"]},
    "literacy_reviewer_code": {"type": ["string", "null"]},
    "language_signoff_hash": {"type": ["string", "null"]},
    "literacy_signoff_hash": {"type": ["string", "null"]},
    "status": {"enum": ["draft", "review", "validated", "under_review", "retired"]},
    "release_eligible": {"type": "boolean"},
    "content_hash": {"type": "string"},
    "normalization_version": {"type": "string"}
  }
}
