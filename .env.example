# --- speech and feedback providers (optional; app runs without them) ---
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- decision gate (tune from the evaluation set, these are placeholders) ---
CONF_MIN=0.6
CONF_HIGH=0.8
ALLOW_DRAFT=1
WITH_LOCAL_STT=0

# --- database (local default is fine; use a long random value on Vultr) ---
POSTGRES_PASSWORD=sp

# --- facilitator protection (required for confirm, comprehension, dashboard) ---
FACILITATOR_PIN=
SECRET_KEY=
FACILITATOR_TOKEN_TTL=3600
# Local only. Opens protected routes without a PIN. Never set on a public server.
DEV_FACILITATOR_OPEN=0

# --- browser access ---
# Exact origins, comma separated, no trailing slash. Example: https://soma-pamoja.vercel.app
CORS_ORIGINS=

# --- proxy address (Vultr only) ---
# Example: 203-0-113-5.sslip.io  (leave empty locally)
SITE_ADDRESS=
